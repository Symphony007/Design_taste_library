{
  "name": "taste",
  "version": "0.1.0",
  "private": true,
  "description": "Taste - A personal design-reference library",
  "type": "module",
  "scripts": {
    "dev:all": "concurrently -k -n \"api,web\" -c \"blue,magenta\" --prefix \"[{name}]\" \"npm run dev\" \"npm --prefix web run dev\"",
    "dev": "tsx watch src/server/index.ts",
    "build": "tsc",
    "start": "node dist/server/index.js",
    "capture": "tsx src/capture/cli.ts",
    "check:playwright": "tsx src/capture/verify-playwright.ts",
    "check:images": "node scripts/test-image-proxy.js"
  },
  "dependencies": {
    "@types/multer": "^2.3.0",
    "archiver": "^8.0.0",
    "better-sqlite3": "^13.0.3",
    "express": "^4.21.2",
    "multer": "^2.5.0",
    "playwright": "^1.50.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "concurrently": "^10.0.6",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
